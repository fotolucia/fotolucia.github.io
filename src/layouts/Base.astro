---
import "../styles/global.css";
import { SITE, url } from "../site";
import IconosTema from "../components/IconosTema.astro";
import IconosIdioma from "../components/IconosIdioma.astro";

interface Props {
  titulo?: string;
  descripcion?: string;
  noindex?: boolean;
}
const { titulo, descripcion = SITE.descripcion, noindex = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITE.nombre}` : `${SITE.nombre} · ${SITE.subtitulo}`;
const ruta = Astro.url.pathname;
const activo = (href: string) => ruta.startsWith(url(href));
// «Fotografías» es la portada y también cada categoría (/fotografias/animales…)
const sinBarraFinal = (r: string) => r.replace(/\/$/, "");
const esFotografias = sinBarraFinal(ruta) === sinBarraFinal(url("/")) || activo("/fotografias");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <!-- Aplica el modo nocturno antes de pintar la página (evita un parpadeo en blanco) -->
    <script is:inline>
      (function () {
        var tema = null;
        try {
          tema = localStorage.getItem("tema");
        } catch (e) {}
        // Por defecto, modo claro (solo cambia si el visitante pulsa la luna)
        document.documentElement.dataset.tema = tema === "oscuro" ? "oscuro" : "claro";
      })();
    </script>
    <!-- Candado abierto si hay una sesión del panel abierta en esta pestaña -->
    <script is:inline>
      (function () {
        var sesion = null;
        try {
          sesion = sessionStorage.getItem("panel-admin");
        } catch (e) {}
        document.documentElement.dataset.sesion = sesion ? "dentro" : "fuera";
      })();
    </script>
  </head>
  <body>
    <header class="cabecera">
      <a href={url("/")} class="logo">
        {SITE.nombre}<span>{SITE.subtitulo}</span>
      </a>
      <nav>
        <a href={url("/")} class:list={{ activo: esFotografias }} data-en="Photography">Fotografías</a>
        <a href={url("/blog")} class:list={{ activo: activo("/blog") }}>Blog</a>
        <a href={url("/contacto")} class:list={{ activo: activo("/contacto") }} data-en="Contact">Contacto</a>
        <button type="button" class="icono idioma" id="cambiar-idioma" data-cambiar-idioma>
          <IconosIdioma />
        </button>
        <button type="button" class="icono tema" id="cambiar-tema" data-cambiar-tema>
          <IconosTema />
        </button>
        <a
          href={url("/admin")}
          class:list={["icono", "candado", { activo: activo("/admin") }]}
          aria-label="Administración"
          title="Administración"
        >
          <svg class="cerrado" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
          <svg class="abierto" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="5" y="11" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path
              d="M8 11V8a4 4 0 0 1 7.7-1.4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <p>© {new Date().getFullYear()} {SITE.nombre}</p>
      <p class="redes">
        <a href={`https://www.instagram.com/${SITE.instagram}/`} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle>
          </svg>
          {SITE.instagram}
        </a>
        <a href={`mailto:${SITE.correo}`}>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
            <path d="m3.5 6 8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          </svg>
          {SITE.correo}
        </a>
      </p>
      <p>
        <a href={url("/")} data-en="Photography">Fotografías</a> ·{" "}
        <a href={url("/blog")}>Blog</a> ·{" "}
        <a href={url("/contacto")} data-en="Contact">Contacto</a> ·{" "}
        <a href={url("/privacidad")} data-en="Privacy">Privacidad</a> ·{" "}
        <a href={url("/aviso-legal")} data-en="Legal notice">Aviso legal</a>
      </p>
    </footer>

    <script>
      // Logo: va a Fotografías (el inicio) recargando la web de verdad. GitHub Pages deja las
      // páginas guardadas en el navegador unos minutos; así se ven siempre las fotos más recientes.
      const logo = document.querySelector<HTMLAnchorElement>(".logo")!;
      logo.addEventListener("click", async (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return; // abrir en otra pestaña, normal
        e.preventDefault();
        try {
          await fetch(logo.href, { cache: "reload" });
        } catch {}
        const sinBarra = (ruta: string) => ruta.replace(/\/$/, "");
        const mismaPagina = sinBarra(location.pathname) === sinBarra(new URL(logo.href).pathname);
        if (mismaPagina) location.reload();
        else location.href = logo.href;
      });

      // Traducción al inglés (bandera). Traduce los textos fijos de la web y los nombres en
      // inglés puestos en el panel (categorías). El resto del contenido (blog, descripciones,
      // pies de foto) sigue en español. Se recuerda mientras la pestaña esté abierta.
      const CLAVE_IDIOMA = "idioma";
      const botonIdioma = document.getElementById("cambiar-idioma")!;
      function aplicarIdioma(idioma: string) {
        const en = idioma === "en";
        document.documentElement.lang = en ? "en" : "es";
        document.documentElement.dataset.idioma = en ? "en" : "es";
        document.querySelectorAll<HTMLElement>("[data-en]").forEach((el) => {
          if (el.dataset.esTexto === undefined) el.dataset.esTexto = el.textContent ?? "";
          el.textContent = en ? el.dataset.en || el.dataset.esTexto : el.dataset.esTexto;
        });
        document.querySelectorAll<HTMLElement>("[data-en-label]").forEach((el) => {
          if (el.dataset.esLabel === undefined) el.dataset.esLabel = el.getAttribute("aria-label") ?? "";
          const texto = en ? el.dataset.enLabel || el.dataset.esLabel : el.dataset.esLabel;
          el.setAttribute("aria-label", texto);
          el.title = texto;
        });
        document.querySelectorAll<HTMLImageElement>("[data-en-alt]").forEach((el) => {
          if (el.dataset.esAlt === undefined) el.dataset.esAlt = el.alt ?? "";
          el.alt = en ? el.dataset.enAlt || el.dataset.esAlt : el.dataset.esAlt;
        });
        botonIdioma.setAttribute("aria-label", en ? "Volver al español" : "Traducir a inglés");
        botonIdioma.title = en ? "Volver al español" : "Traducir a inglés";
        document.dispatchEvent(new CustomEvent("idioma-cambiado", { detail: { idioma: en ? "en" : "es" } }));
      }
      let idiomaGuardado = "es";
      try {
        idiomaGuardado = sessionStorage.getItem(CLAVE_IDIOMA) || "es";
      } catch {}
      aplicarIdioma(idiomaGuardado);
      botonIdioma.addEventListener("click", () => {
        const nuevo = document.documentElement.dataset.idioma === "en" ? "es" : "en";
        try {
          sessionStorage.setItem(CLAVE_IDIOMA, nuevo);
        } catch {}
        aplicarIdioma(nuevo);
      });

      // Botón de modo nocturno
      const raiz = document.documentElement;
      const botones = document.querySelectorAll<HTMLButtonElement>("[data-cambiar-tema]");
      const actualizarBotones = () => {
        const oscuro = raiz.dataset.tema === "oscuro";
        botones.forEach((b) => {
          b.setAttribute("aria-label", oscuro ? "Activar modo claro" : "Activar modo nocturno");
          b.title = oscuro ? "Modo claro" : "Modo nocturno";
        });
      };
      actualizarBotones();
      botones.forEach((b) =>
        b.addEventListener("click", () => {
          raiz.dataset.tema = raiz.dataset.tema === "oscuro" ? "claro" : "oscuro";
          try {
            localStorage.setItem("tema", raiz.dataset.tema);
          } catch {}
          actualizarBotones();
        })
      );
    </script>
  </body>
</html>

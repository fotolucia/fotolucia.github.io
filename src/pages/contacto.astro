---
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
---

<Base titulo="Contacto">
  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>

  <section class="intro">
    <h1 data-en="Contact">Contacto</h1>
    <p data-en="Write to me if you'd like to know more about my work or commission some photos.">
      Escríbeme si quieres saber algo de mi trabajo o encargarme unas fotos.
    </p>
  </section>

  <div class="disposicion">
    <div class="col-formulario">
      <!-- El bloque de Google va FUERA del <form>: así nada de lo que pinte Google (o cualquier
           botón sin type="button") puede disparar un envío del formulario por accidente. El correo
           verificado se añade a mano al enviar (ver el script, más abajo). -->
      <div class="campo">
        <span data-en="Email (verified with Google)">Correo (verificado con Google)</span>
        <div id="google-pendiente">
          <div id="google-boton"></div>
          <p class="ayuda" data-en="Sign in with Google so I can send you a reply — this way I know it's a real address.">
            Inicia sesión con Google para poder enviarte una respuesta: así sé que el correo es real.
          </p>
        </div>
        <div id="google-hecho" class="google-hecho" hidden>
          <p class="google-correo">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M4 12l5 5L20 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ></path>
            </svg>
            <span id="google-correo-texto"></span>
          </p>
          <button type="button" class="enlace" id="google-cambiar" data-en="Change account">Cambiar de cuenta</button>
        </div>
      </div>

      <form id="form-contacto" class="formulario" action={SITE.formulario} method="POST">
        <!-- Trampa para robots: invisible para personas, los bots suelen rellenarlo igualmente -->
        <label class="trampa" aria-hidden="true">
          No rellenar este campo
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </label>

        <label class="campo">
          <span data-en="Name">Nombre</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label class="campo">
          <span data-en="Message">Mensaje</span>
          <textarea name="message" rows="6" required></textarea>
        </label>

        <p class="estado" id="estado-contacto" role="status"></p>
        <button type="submit" class="boton" data-en="Send">Enviar</button>
      </form>
    </div>

    <aside class="col-redes">
      <span class="etiqueta" data-en="Or find me here">O búscame aquí</span>
      <a href={`https://www.instagram.com/${SITE.instagram}/`} target="_blank" rel="noopener" class="enlace-redes">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
          <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle>
        </svg>
        <span>
          <span class="nombre-red">Instagram</span>
          <span class="dato-red">@{SITE.instagram}</span>
        </span>
      </a>
      <a href={`mailto:${SITE.correo}`} class="enlace-redes">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
          <path d="m3.5 6 8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
        <span>
          <span class="nombre-red" data-en="Email">Correo</span>
          <span class="dato-red">{SITE.correo}</span>
        </span>
      </a>
    </aside>
  </div>
</Base>

<style>
  .disposicion {
    display: grid;
    grid-template-columns: minmax(0, 480px) 300px;
    gap: 64px;
    align-items: start;
  }

  @media (max-width: 760px) {
    .disposicion {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  .col-redes {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px 0 0 40px;
    border-left: 1px solid var(--linea);
  }

  @media (max-width: 760px) {
    .col-redes {
      padding: 28px 0 0;
      border-left: 0;
      border-top: 1px solid var(--linea);
    }
  }

  .enlace-redes {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  /* Sin esto, un correo largo (una sola palabra, sin espacios) encoge el icono hasta hacerlo desaparecer */
  .enlace-redes svg {
    flex-shrink: 0;
  }

  .enlace-redes span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .nombre-red {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--suave);
  }

  .dato-red {
    font-size: 1rem;
    overflow-wrap: anywhere;
    transition: text-decoration-color 0.2s;
  }

  .enlace-redes:hover .dato-red {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .formulario {
    max-width: 520px;
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .trampa {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 520px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--suave);
  }

  input,
  textarea {
    font: inherit;
    font-size: 1rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--texto);
    padding: 12px 14px;
    border: 1px solid var(--linea);
    background: var(--campo);
    border-radius: 2px;
    width: 100%;
  }

  textarea {
    resize: vertical;
    line-height: 1.5;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--texto);
    outline-offset: -1px;
  }

  .boton {
    align-self: flex-start;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 28px;
    border: 1px solid var(--texto);
    background: var(--texto);
    color: var(--fondo);
    cursor: pointer;
    border-radius: 2px;
  }

  .boton:hover:not(:disabled) {
    opacity: 0.85;
  }

  .boton:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .estado {
    margin: 0;
    min-height: 1.4em;
    font-size: 0.92rem;
  }

  .estado.ok {
    color: var(--exito);
  }

  .estado.mal {
    color: var(--peligro);
  }

  .ayuda {
    margin: 10px 0 0;
    font-size: 0.85rem;
    text-transform: none;
    letter-spacing: normal;
    color: var(--suave);
  }

  #google-boton {
    margin-top: 4px;
  }

  .google-hecho {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 4px;
  }

  .google-correo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--exito);
    font-size: 1rem;
    text-transform: none;
    letter-spacing: normal;
  }

  .enlace {
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--suave);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .enlace:hover {
    color: var(--texto);
  }
</style>

<script>
  import { SITE } from "../site";

  const form = document.getElementById("form-contacto") as HTMLFormElement;
  const estado = document.getElementById("estado-contacto")!;
  const boton = form.querySelector("button")!;
  const enIngles = () => document.documentElement.dataset.idioma === "en";

  // ---------- inicio de sesión con Google (correo verificado) ----------
  const pendiente = document.getElementById("google-pendiente")!;
  const hecho = document.getElementById("google-hecho")!;
  const correoTexto = document.getElementById("google-correo-texto")!;
  let correoVerificado = "";

  // El token que da Google son tres trozos separados por ".": solo se lee el de en medio
  // (los datos), en el navegador, sin enviarlo a ningún sitio.
  function leerCorreoDelToken(token: string): string {
    const payload = token.split(".")[1];
    const json = decodeURIComponent(
      atob(payload.replace(/-/g, "+").replace(/_/g, "/"))
        .split("")
        .map((c) => "%" + c.charCodeAt(0).toString(16).padStart(2, "0"))
        .join("")
    );
    return JSON.parse(json).email ?? "";
  }

  function mostrarVerificado(correo: string) {
    correoVerificado = correo;
    correoTexto.textContent = correo;
    pendiente.hidden = true;
    hecho.hidden = false;
  }

  function mostrarPendiente() {
    correoVerificado = "";
    pendiente.hidden = false;
    hecho.hidden = true;
  }

  function iniciarGoogle() {
    const google = (window as any).google;
    if (!google) {
      setTimeout(iniciarGoogle, 150);
      return;
    }
    google.accounts.id.initialize({
      client_id: SITE.googleClientId,
      callback: (respuesta: { credential: string }) => mostrarVerificado(leerCorreoDelToken(respuesta.credential)),
    });
    google.accounts.id.renderButton(document.getElementById("google-boton"), {
      type: "standard",
      theme: "outline",
      size: "large",
      text: "signin_with",
      locale: enIngles() ? "en" : "es",
    });
  }
  if (!SITE.googleClientId.includes("REEMPLAZAR")) iniciarGoogle();

  document.getElementById("google-cambiar")!.addEventListener("click", () => {
    (window as any).google?.accounts.id.disableAutoSelect();
    mostrarPendiente();
  });

  // ---------- límite de envíos (aviso, no una protección real) ----------
  // Se guarda en este navegador cuándo se envió el último mensaje. Como no hay servidor,
  // alguien podría saltárselo borrando los datos del navegador; esto solo frena los despistes
  // (pulsar «Enviar» varias veces) y a quien no se moleste en sortearlo.
  const CLAVE_ULTIMO_ENVIO = "ultimoEnvioContacto";
  const ESPERA_MIN = 20; // como mucho, unos 3 mensajes por hora

  function minutosParaPoderEnviar(): number {
    try {
      const ultimo = Number(localStorage.getItem(CLAVE_ULTIMO_ENVIO) || 0);
      return Math.max(0, Math.ceil(ESPERA_MIN - (Date.now() - ultimo) / 60000));
    } catch {
      return 0;
    }
  }

  // ---------- enviar el formulario ----------
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (SITE.formulario.includes("REEMPLAZAR") || SITE.googleClientId.includes("REEMPLAZAR")) {
      estado.textContent = enIngles()
        ? "The form isn't set up yet. Please write to " + SITE.correo
        : "El formulario todavía no está configurado. Escribe a " + SITE.correo;
      estado.className = "estado mal";
      return;
    }
    if (!correoVerificado) {
      estado.textContent = enIngles()
        ? "Please sign in with Google first, so I know your email is real."
        : "Antes tienes que iniciar sesión con Google, para saber que el correo es real.";
      estado.className = "estado mal";
      return;
    }
    const espera = minutosParaPoderEnviar();
    if (espera > 0) {
      estado.textContent = enIngles()
        ? `Please wait about ${espera} more minute${espera === 1 ? "" : "s"} before sending another message.`
        : `Espera ${espera} minuto${espera === 1 ? "" : "s"} más antes de enviar otro mensaje.`;
      estado.className = "estado mal";
      return;
    }
    boton.disabled = true;
    estado.className = "estado";
    estado.textContent = enIngles() ? "Sending…" : "Enviando…";
    try {
      const datos = new FormData(form);
      datos.set("email", correoVerificado); // el correo no vive en el formulario, se añade aquí
      // Formspree usa este campo como asunto del correo que le llega a Lucía
      const nombre = String(datos.get("name") ?? "").trim();
      datos.set("_subject", nombre ? `Foto Lucía · Mensaje de ${nombre}` : "Foto Lucía · Nuevo mensaje de contacto");
      const res = await fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: datos,
      });
      if (!res.ok) throw new Error();
      try {
        localStorage.setItem(CLAVE_ULTIMO_ENVIO, String(Date.now()));
      } catch {}
      form.reset();
      mostrarPendiente();
      estado.textContent = enIngles() ? "✓ Message sent. Thank you!" : "✓ Mensaje enviado. ¡Gracias!";
      estado.classList.add("ok");
    } catch {
      estado.textContent = enIngles()
        ? `✗ Something went wrong. Please try again, or write to ${SITE.correo}.`
        : `✗ Algo ha fallado. Inténtalo de nuevo, o escribe a ${SITE.correo}.`;
      estado.classList.add("mal");
    } finally {
      boton.disabled = false;
    }
  });
</script>

---
import { render } from "astro:content";
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import { entradasOrdenadas } from "../../lib";
import { formatoFecha, formatoFechaEn, url } from "../../site";

export async function getStaticPaths() {
  const entradas = await entradasOrdenadas();
  return entradas.map((entrada) => ({ params: { slug: entrada.id }, props: { entrada } }));
}

const { entrada } = Astro.props;
const { titulo, tituloEn, fecha, portada, resumen, cuerpoEn } = entrada.data;
const { Content } = await render(entrada);
// El texto en inglés (si lo hay) se escribe aparte en el panel, así que se convierte de
// Markdown a HTML aquí; si no se ha escrito, en inglés se sigue viendo el texto en español.
const htmlEn = cuerpoEn ? await marked.parse(cuerpoEn) : "";
---

<Base titulo={titulo} descripcion={resumen ?? undefined}>
  <article>
    <header>
      <a href={url("/blog")} class="etiqueta volver" data-en="← Blog">← Blog</a>
      <h1 data-en={tituloEn || titulo}>{titulo}</h1>
      <time class="etiqueta" datetime={fecha.toISOString()} data-en={formatoFechaEn(fecha)}>{formatoFecha(fecha)}</time>
    </header>

    {portada && <img class="portada" src={url(portada)} alt="" />}

    <div class={`texto ${htmlEn ? "con-ingles" : ""}`}>
      <div class="texto-es">
        <Content />
      </div>
      {htmlEn && <div class="texto-en" set:html={htmlEn} />}
    </div>
  </article>
</Base>

<style>
  article header {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 0 40px;
    text-align: center;
  }

  .volver {
    text-decoration: none;
    display: inline-block;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.3rem, 6vw, 3.4rem);
    margin-bottom: 16px;
  }

  .portada {
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: 78vh;
    object-fit: cover;
    margin-bottom: 56px;
  }

  .texto {
    max-width: 660px;
    margin: 0 auto;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  /* Solo se justifican los párrafos que se marquen como tal desde el botón del editor */
  .texto :global(.justificado) {
    text-align: justify;
  }

  /* Si hay texto en inglés escrito, se cambia al pulsar la bandera; si no, se queda en español */
  .texto .texto-en {
    display: none;
  }

  :global([data-idioma="en"]) .texto.con-ingles .texto-es {
    display: none;
  }

  :global([data-idioma="en"]) .texto.con-ingles .texto-en {
    display: block;
  }

  .texto :global(h2) {
    font-size: 2rem;
    margin: 48px 0 12px;
  }

  .texto :global(h3) {
    font-size: 1.5rem;
    margin: 36px 0 8px;
  }

  .texto :global(img) {
    margin: 40px auto;
  }

  .texto :global(blockquote) {
    margin: 40px 0;
    padding: 0 0 0 24px;
    border-left: 1px solid var(--texto);
    font-family: var(--serif);
    font-size: 1.6rem;
    font-style: italic;
    line-height: 1.4;
  }

  .texto :global(blockquote p) {
    margin: 0;
  }

  .texto :global(a) {
    text-underline-offset: 4px;
  }
</style>

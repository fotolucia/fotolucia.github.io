---
import Base from "../layouts/Base.astro";
import IconoTraducirIA from "../components/IconoTraducirIA.astro";
import "easymde/dist/easymde.min.css";
---

<Base titulo="Administración" noindex>
  <!-- Acceso -->
  <section id="login" class="login">
    <h1 data-en="Log in">Acceso</h1>
    <p class="suave" data-en="Administration panel">Panel de administración</p>
    <form id="form-login">
      <label>
        <span data-en="Username">Usuario</span>
        <input name="usuario" autocomplete="username" required />
      </label>
      <label>
        <span data-en="Password">Contraseña</span>
        <input name="clave" type="password" autocomplete="current-password" required />
      </label>
      <p class="error" id="error-login" role="alert"></p>
      <button type="submit" class="boton principal" data-en="Log in">Entrar</button>
    </form>
  </section>

  <!-- Panel -->
  <section id="panel" class="panel" hidden>
    <div class="panel-cabecera">
      <h1>Panel de administración</h1>
      <nav class="pestanas">
        <button type="button" data-vista="categorias" class="activa">Categorías</button>
        <button type="button" data-vista="blog">Blog</button>
        <button type="button" id="cerrar-panel" class="cerrar">Cerrar panel</button>
      </nav>
    </div>

    <p class="aviso" id="aviso-local" hidden>
      Modo local: los cambios se guardan en los archivos de este ordenador.
    </p>
    <p class="estado" id="estado" role="status"></p>

    <!-- 1. Categorías -->
    <div class="vista" data-vista="categorias">
      <div class="vista-cabecera">
        <h2>Categorías</h2>
        <button type="button" class="boton principal" id="nueva-categoria">+ Añadir categoría</button>
      </div>
      <ul class="lista" id="lista-categorias"></ul>
    </div>

    <!-- 1b. Modificar categoría -->
    <div class="vista" data-vista="editar" hidden>
      <button type="button" class="volver" id="volver-categorias">← Categorías</button>
      <h2 id="editar-titulo"></h2>

      <div class="campos-nombre">
        <label class="campo">
          Nombre (español)
          <input id="editar-nombre" />
        </label>
        <label class="campo">
          <span class="campo-cabecera">
            Nombre (inglés)
            <button
              type="button"
              class="traducir-ia"
              data-desde="editar-nombre"
              data-hacia="editar-nombre-en"
              data-idioma="en"
              aria-label="Traducir con IA"
              title="Traducir con IA"
            >
              <IconoTraducirIA />
            </button>
          </span>
          <input id="editar-nombre-en" placeholder="Igual que en español" />
        </label>
      </div>

      <div class="campos-nombre">
        <label class="campo">
          Descripción (español)
          <textarea id="editar-descripcion" rows="2" placeholder="Sin descripción"></textarea>
        </label>
        <label class="campo">
          <span class="campo-cabecera">
            Descripción (inglés)
            <button
              type="button"
              class="traducir-ia"
              data-desde="editar-descripcion"
              data-hacia="editar-descripcion-en"
              data-idioma="en"
              aria-label="Traducir con IA"
              title="Traducir con IA"
            >
              <IconoTraducirIA />
            </button>
          </span>
          <textarea id="editar-descripcion-en" rows="2" placeholder="Igual que en español"></textarea>
        </label>
      </div>

      <div class="vista-cabecera">
        <h3>Fotos <span class="suave" id="editar-contador"></span></h3>
        <label class="boton">
          + Añadir imágenes desde tu ordenador
          <input type="file" id="editar-subir" accept="image/*" multiple hidden />
        </label>
      </div>
      <p class="ayuda">Arrastra las fotos para cambiar el orden: la primera es la portada. Pulsa una foto para ponerle nombre.</p>
      <ul class="fotos" id="editar-fotos"></ul>

      <div class="acciones">
        <button type="button" class="boton" id="editar-cancelar">Cancelar</button>
        <button type="button" class="boton principal" id="editar-guardar">Guardar cambios</button>
      </div>
    </div>

    <!-- 2. Blog -->
    <div class="vista" data-vista="blog" hidden>
      <div class="vista-cabecera">
        <h2>Blog</h2>
        <button type="button" class="boton principal" id="nueva-entrada">+ Añadir entrada</button>
      </div>
      <ul class="lista" id="lista-blog"></ul>
    </div>

    <!-- 2b. Modificar entrada -->
    <div class="vista" data-vista="editar-entrada" hidden>
      <button type="button" class="volver" id="volver-blog">← Blog</button>
      <h2 id="entrada-titulo-visor"></h2>

      <div class="campos-nombre">
        <label class="campo">
          Título (español)
          <input id="entrada-titulo" />
        </label>
        <label class="campo">
          <span class="campo-cabecera">
            Título (inglés)
            <button
              type="button"
              class="traducir-ia"
              data-desde="entrada-titulo"
              data-hacia="entrada-titulo-en"
              data-idioma="en"
              aria-label="Traducir con IA"
              title="Traducir con IA"
            >
              <IconoTraducirIA />
            </button>
          </span>
          <input id="entrada-titulo-en" placeholder="Igual que en español" />
        </label>
      </div>

      <label class="campo">
        Fecha
        <input id="entrada-fecha" type="date" />
      </label>

      <div class="campos-nombre">
        <label class="campo">
          Resumen (español)
          <input id="entrada-resumen" placeholder="Una o dos frases, sale en el listado del blog" />
        </label>
        <label class="campo">
          <span class="campo-cabecera">
            Resumen (inglés)
            <button
              type="button"
              class="traducir-ia"
              data-desde="entrada-resumen"
              data-hacia="entrada-resumen-en"
              data-idioma="en"
              aria-label="Traducir con IA"
              title="Traducir con IA"
            >
              <IconoTraducirIA />
            </button>
          </span>
          <input id="entrada-resumen-en" placeholder="Igual que en español" />
        </label>
      </div>

      <div class="vista-cabecera">
        <h3>Fotografía principal</h3>
      </div>
      <div class="portada-entrada">
        <div class="portada-marco" id="entrada-portada-marco">
          <span class="suave">Sin foto</span>
        </div>
        <div class="portada-botones">
          <label class="boton">
            Cambiar imagen
            <input type="file" id="entrada-subir-portada" accept="image/*" hidden />
          </label>
          <button type="button" class="boton" id="entrada-quitar-portada" hidden>Quitar</button>
        </div>
      </div>

      <div class="vista-cabecera">
        <h3>Texto (español)</h3>
      </div>
      <textarea id="entrada-cuerpo"></textarea>

      <div class="vista-cabecera">
        <h3>Texto (inglés)</h3>
      </div>
      <p class="ayuda">Déjalo en blanco para que, en inglés, se siga viendo el texto en español.</p>
      <textarea id="entrada-cuerpo-en"></textarea>

      <div class="acciones">
        <button type="button" class="boton" id="entrada-cancelar">Cancelar</button>
        <button type="button" class="boton principal" id="entrada-guardar">Guardar cambios</button>
      </div>
    </div>
  </section>

  <!-- Diálogo: nombre de nueva categoría -->
  <dialog id="dialogo-nombre" class="dialogo">
    <form method="dialog">
      <h3>Nueva categoría</h3>
      <label class="campo">
        Nombre
        <input name="nombre" required />
      </label>
      <p class="error" id="error-nombre"></p>
      <div class="acciones">
        <button type="button" class="boton" value="cancelar" data-cerrar>Cancelar</button>
        <button type="submit" class="boton principal" value="ok">Crear</button>
      </div>
    </form>
  </dialog>

  <!-- Diálogo: nueva entrada del blog -->
  <dialog id="dialogo-entrada" class="dialogo">
    <form method="dialog">
      <h3>Nueva entrada</h3>
      <label class="campo">
        Título
        <input name="titulo" required />
      </label>
      <p class="error" id="error-entrada"></p>
      <div class="acciones">
        <button type="button" class="boton" value="cancelar" data-cerrar>Cancelar</button>
        <button type="submit" class="boton principal" value="ok">Crear</button>
      </div>
    </form>
  </dialog>

  <!-- Diálogo: nombre de una foto -->
  <dialog id="dialogo-foto" class="dialogo">
    <form method="dialog">
      <h3>Nombre de la foto</h3>
      <img id="foto-vista" alt="" />
      <div class="campos-nombre">
        <label class="campo">
          Nombre (español)
          <input id="foto-nombre" name="titulo" placeholder="Sin nombre" />
        </label>
        <label class="campo">
          <span class="campo-cabecera">
            Nombre (inglés)
            <button
              type="button"
              class="traducir-ia"
              data-desde="foto-nombre"
              data-hacia="foto-nombre-en"
              data-idioma="en"
              aria-label="Traducir con IA"
              title="Traducir con IA"
            >
              <IconoTraducirIA />
            </button>
          </span>
          <input id="foto-nombre-en" name="tituloEn" placeholder="Igual que en español" />
        </label>
      </div>
      <div class="acciones">
        <button type="button" class="boton" data-cerrar>Cancelar</button>
        <button type="submit" class="boton principal" value="ok">Aceptar</button>
      </div>
    </form>
  </dialog>

  <!-- Diálogo: confirmación -->
  <dialog id="dialogo-confirmar" class="dialogo">
    <form method="dialog">
      <h3 id="confirmar-titulo">¿Estás segura?</h3>
      <p id="confirmar-texto"></p>
      <div class="acciones">
        <button type="button" class="boton" data-cerrar>Cancelar</button>
        <button type="submit" class="boton peligro" value="ok">Sí, eliminar</button>
      </div>
    </form>
  </dialog>
</Base>

<style is:global>
  /* El atributo hidden debe ganar siempre, aunque la clase (p. ej. .boton) fije su propio display */
  [hidden] {
    display: none !important;
  }

  .suave {
    color: var(--suave);
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  h2 {
    font-size: 1.9rem;
  }

  h3 {
    font-size: 1.4rem;
  }

  /* Formularios */
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--suave);
  }

  /* Fila de la etiqueta cuando lleva el botón «Traducir con IA» a la derecha */
  .campo-cabecera {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .traducir-ia {
    display: inline-flex;
    background: none;
    border: 0;
    padding: 2px;
    margin: 0;
    cursor: pointer;
    color: var(--texto);
  }

  .traducir-ia:hover:not(:disabled) {
    color: var(--suave);
  }

  .traducir-ia:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .traducir-ia.cargando svg {
    animation: girar 0.9s linear infinite;
  }

  .traducir-ia.error {
    color: var(--peligro);
  }

  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }

  input:not([type="file"]),
  textarea {
    font: inherit;
    font-size: 1rem;
    letter-spacing: normal;
    text-transform: none;
    color: var(--texto);
    padding: 12px 14px;
    border: 1px solid var(--linea);
    background: var(--campo);
    border-radius: 2px;
    width: 100%;
  }

  textarea {
    resize: vertical;
    line-height: 1.5;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid var(--texto);
    outline-offset: -1px;
  }

  .error {
    color: var(--peligro);
    font-size: 0.9rem;
    min-height: 1.4em;
    margin: 0;
  }

  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 18px;
    border: 1px solid var(--texto);
    background: transparent;
    color: var(--texto);
    cursor: pointer;
    border-radius: 2px;
    white-space: nowrap;
  }

  .boton:hover:not(:disabled) {
    background: var(--texto);
    color: var(--fondo);
  }

  .boton.principal {
    background: var(--texto);
    color: var(--fondo);
  }

  .boton.principal:hover:not(:disabled) {
    opacity: 0.85;
  }

  .boton.peligro {
    background: var(--peligro);
    border-color: var(--peligro);
    color: var(--fondo);
  }

  .boton:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Acceso */
  .login {
    max-width: 380px;
    margin: 64px auto 0;
  }

  .login p.suave {
    margin: 6px 0 32px;
  }

  .login form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Panel */
  .panel-cabecera {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    padding: 40px 0 20px;
    border-bottom: 1px solid var(--linea);
  }

  .pestanas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .pestanas button {
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 8px 10px;
    cursor: pointer;
    color: var(--suave);
  }

  .pestanas button:hover,
  .pestanas button.activa {
    color: var(--texto);
    border-color: var(--texto);
  }

  .pestanas .cerrar {
    color: var(--peligro);
  }

  .aviso {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: var(--suave);
  }

  .estado {
    min-height: 1.6em;
    margin: 16px 0 0;
    font-size: 0.95rem;
  }

  .estado.ok {
    color: var(--exito);
  }

  .estado.mal {
    color: var(--peligro);
  }

  .vista {
    padding-top: 16px;
  }

  .vista-cabecera {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin: 16px 0 24px;
  }

  /* Lista de categorías */
  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--linea);
  }

  .lista li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea);
  }

  /* Solo la foto se atenúa; el nombre y los botones se quedan nítidos */
  .lista li.fila-oculta img,
  .lista li.fila-oculta .sin-foto {
    opacity: 0.55;
  }

  .etiqueta-oculta {
    display: inline-block;
    vertical-align: middle;
    font-family: var(--sans);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--suave);
    border: 1px solid var(--linea);
    border-radius: 2px;
    padding: 2px 6px;
    margin-left: 4px;
  }

  .lista img,
  .lista .sin-foto {
    width: 64px;
    height: 64px;
    object-fit: cover;
    background: var(--linea);
    flex-shrink: 0;
  }

  .lista .info {
    flex: 1;
    min-width: 0;
  }

  .lista .nombre {
    font-family: var(--serif);
    font-size: 1.4rem;
    display: block;
  }

  .lista .contador {
    font-size: 0.85rem;
    color: var(--suave);
  }

  .lista .botones {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 560px) {
    .lista li {
      flex-wrap: wrap;
    }
    .lista .botones {
      width: 100%;
      justify-content: stretch;
    }
    .lista .botones .boton {
      flex: 1;
    }
  }

  /* Editar categoría */
  .volver {
    font: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    color: var(--suave);
    margin: 8px 0 16px;
  }

  .volver:hover {
    color: var(--texto);
  }

  .campo {
    max-width: 420px;
    margin: 24px 0 8px;
  }

  .campos-nombre {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .campos-nombre .campo {
    flex: 1;
    min-width: 200px;
  }


  .fotos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 12px;
  }

  .ayuda {
    margin: -12px 0 16px;
    font-size: 0.85rem;
    color: var(--suave);
  }

  .fotos li {
    position: relative;
    cursor: grab;
    touch-action: manipulation;
  }

  .fotos .miniatura {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: var(--linea);
    cursor: inherit;
  }

  .fotos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .fotos .nombre-foto {
    display: block;
    margin-top: 6px;
    font-size: 0.82rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .fotos .nombre-foto.vacio {
    color: var(--suave);
    font-style: italic;
  }

  /* Etiquetas sobre la foto: «Portada» (la primera) y «Nueva» (sin guardar) */
  .fotos .etiquetas {
    position: absolute;
    left: 6px;
    top: 6px;
    display: flex;
    gap: 4px;
    pointer-events: none;
  }

  .fotos .etiquetas span {
    background: var(--texto);
    color: var(--fondo);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 6px;
  }

  /* Mientras se arrastra */
  .fotos .arrastrando {
    opacity: 0.35;
  }

  .fotos .elegida .miniatura {
    outline: 2px solid var(--texto);
    outline-offset: 2px;
  }

  #foto-vista {
    width: 100%;
    max-height: 240px;
    object-fit: contain;
    background: var(--linea);
    margin-top: 16px;
  }

  .fotos .quitar {
    position: absolute;
    right: 6px;
    top: 6px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 0;
    background: var(--fondo);
    color: var(--peligro);
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .fotos .quitar:hover {
    background: var(--peligro);
    color: var(--fondo);
  }

  /* Ojo: a la izquierda de la X, oculta o muestra esa foto en la web */
  .fotos .ojo {
    position: absolute;
    right: 42px;
    top: 6px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 0;
    background: var(--fondo);
    color: var(--texto);
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
  }

  .fotos .ojo:hover {
    background: var(--texto);
    color: var(--fondo);
  }

  .fotos .ojo .cerrado {
    display: none;
  }

  .fotos .foto-oculta .ojo .abierto {
    display: none;
  }

  .fotos .foto-oculta .ojo .cerrado {
    display: block;
  }

  /* Foto oculta: en gris y algo más tenue */
  .fotos .foto-oculta .miniatura img {
    filter: grayscale(1);
    opacity: 0.55;
  }

  .acciones {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  /* Fotografía principal de una entrada del blog */
  .portada-entrada {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 8px;
  }

  .portada-marco {
    width: 160px;
    height: 110px;
    flex-shrink: 0;
    background: var(--linea);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .portada-marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portada-botones {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  /* Editor de texto (EasyMDE), a juego con el resto del panel */
  #entrada-cuerpo,
  #entrada-cuerpo-en {
    display: none; /* EasyMDE lo sustituye por su propio editor */
  }

  .EasyMDEContainer .CodeMirror {
    border: 1px solid var(--linea);
    background: var(--campo);
    color: var(--texto);
    font-family: var(--sans);
    font-size: 1rem;
    min-height: 320px;
  }

  .EasyMDEContainer .CodeMirror-cursor {
    border-color: var(--texto);
  }

  .EasyMDEContainer .editor-toolbar {
    border: 1px solid var(--linea);
    border-bottom: 0;
